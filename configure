#!/usr/bin/env python3

import os, sys

if sys.version_info < (3,6):
  print('*******************************************************************************')
  print('*           Python version 3.6+ is required to run ./configure                *')
  print('*******************************************************************************')
  sys.exit(4)

with open(os.path.join(os.path.dirname(__file__), 'config', 'configure.py')) as f:
  exec(f.read())
